int main(int argument_count, char *arguments[])
{
    if (argument_count == 2 && strcmp(arguments[1], "--self-test") == 0) {
        return run_self_tests();
    }
    if (argument_count == 4 && strcmp(arguments[1], "--json") == 0) {
        return print_json_report(arguments[2], arguments[3]);
    }
    if (argument_count != 1) {
        fputs("Usage:\n"
              "  urban_air_quality                  Interactive console\n"
              "  urban_air_quality --self-test      Run built-in checks\n"
              "  urban_air_quality --json 35.5 80    Machine-readable result\n"
              "JSON arguments: PM2.5, then PM10; both are 24-hour averages\n"
              "in micrograms per cubic meter.\n", stderr);
        return EXIT_FAILURE;
    }

    AirQualityReading history[HISTORY_LIMIT] = {0};
    size_t history_count = 0;
    bool running = true;
    char menu_choice[INPUT_CAPACITY];

    print_welcome_banner();
    while (running) {
        puts("\nMAIN MENU");
        puts("  1. Calculate air quality for an area or city");
        puts("  2. View recent readings and their air quality categories");
        puts("  3. Run the fictional three-day demonstration");
        puts("  4. Exit the Urban Air Quality Assistant");
        if (!read_console_line("Enter a menu option from 1 to 4 (example: 1): ",
                               menu_choice, sizeof menu_choice)) {
            break;
        }
        if (strlen(menu_choice) != 1) {
            puts("Invalid menu option. Enter one number from 1 to 4, for example 1.");
            continue;
        }
        switch (menu_choice[0]) {
            case '1':
                running = check_area_air_quality(history, &history_count);
                break;
            case '2':
                print_reading_history(history, history_count);
                break;
            case '3':
                run_sample_demonstration();
                break;
            case '4':
                running = false;
                break;
            default:
                puts("Invalid menu option. Enter one number from 1 to 4, for example 1.");
                break;
        }
    }
    if (ferror(stdin)) {
        fputs("\nInput could not be read. The program has stopped safely.\n", stderr);
        return EXIT_FAILURE;
    }
    puts("\nThank you for using the Urban Air Quality Assistant. Goodbye.");
    return ferror(stdout) ? EXIT_FAILURE : EXIT_SUCCESS;
}
