#define MAX_CONCENTRATION 10000L
#define HISTORY_LIMIT 10
#define AREA_NAME_CAPACITY 128
#define INPUT_CAPACITY 256
#define BREAKPOINT_COUNT 6
#define FINE_PARTICLE_SCALE 10L
#define INHALABLE_PARTICLE_SCALE 1L
#define ARRAY_COUNT(array) (sizeof(array) / sizeof((array)[0]))

/* Guard the intermediate multiplication if the input limit is edited. */
_Static_assert(MAX_CONCENTRATION > 0 &&
               MAX_CONCENTRATION <= (LONG_MAX - 500L) / 5000L,
               "The concentration limit must fit long integer arithmetic.");
_Static_assert(HISTORY_LIMIT > 0, "History must hold at least one reading.");
_Static_assert(AREA_NAME_CAPACITY >= 2 && INPUT_CAPACITY >= 2,
               "Text buffers need space for a character and a terminator.");

typedef struct {
    long concentration_low;
    long concentration_high;
    long index_low;
    long index_high;
} AqiBreakpoint;

typedef struct {
    char area_name[AREA_NAME_CAPACITY];
    long fine_particle_tenths;    /* PM2.5: 355 represents 35.5 micrograms/m3. */
    long inhalable_particles;    /* PM10: whole micrograms/m3. */
    long fine_particle_aqi;
    long inhalable_particle_aqi;
    long overall_aqi;
    size_t category_index;
} AirQualityReading;

/* Scaled integers preserve decimal truncation without floating-point error. */
static const AqiBreakpoint FINE_PARTICLE_BREAKPOINTS[BREAKPOINT_COUNT] = {
    {   0,   90,   0,  50},
    {  91,  354,  51, 100},
    { 355,  554, 101, 150},
    { 555, 1254, 151, 200},
    {1255, 2254, 201, 300},
    {2255, 3254, 301, 500}
};

static const AqiBreakpoint INHALABLE_PARTICLE_BREAKPOINTS[BREAKPOINT_COUNT] = {
    {  0,  54,   0,  50},
    { 55, 154,  51, 100},
    {155, 254, 101, 150},
    {255, 354, 151, 200},
    {355, 424, 201, 300},
    {425, 604, 301, 500}
};

static const char *const CATEGORY_NAMES[BREAKPOINT_COUNT] = {
    "Good", "Moderate", "Unhealthy for Sensitive Groups",
    "Unhealthy", "Very Unhealthy", "Hazardous"
};

